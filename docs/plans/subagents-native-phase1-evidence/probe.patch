+/** Fork-owned probe: a minimal `Agent` base tool bound to the session's subagent service. */
+import { Type } from "typebox";
+import { defineTool, type ToolDefinition } from "../../extensions/types.ts";
+import type { SubagentService } from "./service.ts";
+
+export const AGENT_TOOL_NAME = "Agent";
+
+export function createAgentToolDefinition(
+	service: () => SubagentService,
+	childExcludedTools: () => string[],
+): ToolDefinition {
+	return defineTool({
+		name: AGENT_TOOL_NAME,
+		label: "Agent",
+		description: "Probe: run a prompt in a child session and return its final text.",
+		parameters: Type.Object({ prompt: Type.String() }),
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			const child = await service().spawn({
+				prompt: params.prompt,
+				cwd: ctx.cwd,
+				excludeTools: childExcludedTools(),
+			});
+			const text = await child.done;
+			return { content: [{ type: "text", text }], details: undefined };
+		},
+	});
+}
diff --git a/packages/coding-agent/src/core/fork-builtins/subagents/service.ts b/packages/coding-agent/src/core/fork-builtins/subagents/service.ts
