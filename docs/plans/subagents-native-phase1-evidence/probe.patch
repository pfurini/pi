@@ -0,0 +1,134 @@
+/**
+ * Probe for the native subagent service (handoff D18, D21, D22, D25). Real parent sessions on
+ * the suite harness; each child is built by `createAgentSession` from the parent's model runtime.
+ */
+import { getCurrentTools } from "@earendil-works/pi-ai";
+import { type Context, fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/compat";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createEventBus, type EventBus } from "../../src/core/event-bus.ts";
+import { subagentServiceFor } from "../../src/core/fork-builtins/subagents/service.ts";
+import { createHarness, getAssistantTexts, type Harness } from "./harness.ts";
+
+const harnesses: Harness[] = [];
+
+afterEach(() => {
+	for (const harness of harnesses.splice(0)) harness.cleanup();
+	vi.unstubAllEnvs();
+});
+
+async function parent(eventBus?: EventBus): Promise<Harness> {
+	vi.stubEnv("PI_FORK_BUILTINS", "on");
+	const harness = await createHarness(eventBus ? { eventBus } : {});
+	harnesses.push(harness);
+	return harness;
+}
+
+describe("native subagent service probe", () => {
+	it("runs a child from the parent's model runtime and returns its text through Agent", async () => {
+		const harness = await parent();
+		const childTools: string[] = [];
+		harness.setResponses([
+			fauxAssistantMessage([fauxToolCall("Agent", { prompt: "count files" })], { stopReason: "toolUse" }),
+			(context: Context) => {
+				childTools.push(...getCurrentTools(context.messages).map((tool) => tool.name));
+				return fauxAssistantMessage("child says 42");
+			},
+			fauxAssistantMessage("parent done"),
+		]);
+		await harness.session.prompt("delegate");
+		const toolResult = harness.session.messages.find((message) => message.role === "toolResult");
+		expect(JSON.stringify(toolResult)).toContain("child says 42");
+		expect(getAssistantTexts(harness).at(-1)).toBe("parent done");
+		expect(childTools, "the child sees no fork base tool and no Agent (D22)").not.toContain("Agent");
+		expect(childTools).not.toContain("ask_user_question");
+		expect(childTools).not.toContain("vcc_recall");
+		expect(childTools).toContain("read");
+	});
+
+	it("drops inline built-ins from the child's loader (D22)", async () => {
+		const harness = await parent();
+		const service = subagentServiceFor(harness.session, harness.tempDir);
+		harness.setResponses([fauxAssistantMessage("ok")]);
+		const child = await service.spawn({ prompt: "hi", cwd: harness.tempDir, excludeTools: [] });
+		await child.done;
+		const paths = child.loader.getExtensions().extensions.map((extension) => extension.path);
+		expect(paths.filter((path) => path.startsWith("<inline:"))).toEqual([]);
+	});
+
+	it("keeps one service across /reload", async () => {
+		const harness = await parent();
+		const before = subagentServiceFor(harness.session, harness.tempDir);
+		await harness.session.reload();
+		expect(subagentServiceFor(harness.session, harness.tempDir)).toBe(before);
+		expect(harness.session.getAllTools().some((tool) => tool.name === "Agent")).toBe(true);
+	});
+
+	it("parent dispose ends a running child through the session cleanup hook (D21)", async () => {
+		const harness = await parent();
+		const service = subagentServiceFor(harness.session, harness.tempDir);
+		let release: (() => void) | undefined;
+		harness.setResponses([
+			async () => {
+				await new Promise<void>((resolve) => {
+					release = resolve;
+				});
+				return fauxAssistantMessage("late");
+			},
+		]);
+		const child = await service.spawn({ prompt: "slow", cwd: harness.tempDir, excludeTools: [] });
+		await vi.waitFor(() => expect(release).toBeDefined());
+		harness.session.dispose();
+		expect(service.isDisposed).toBe(true);
+		expect(service.children.size).toBe(0);
+		release?.();
+		await child.done.catch(() => undefined);
+		const last = child.session.messages.filter((message) => message.role === "assistant").at(-1);
+		expect(last && "stopReason" in last ? last.stopReason : undefined).toBe("aborted");
+	});
+
+	it("answers subagents:rpc:ping on a fresh session, before any tool call (D19)", async () => {
+		const bus = createEventBus();
+		await parent(bus);
+		expect(await ping(bus)).toEqual({
+			success: true,
+			data: { version: 3, capabilities: { skillAgents: true } },
+		});
+	});
+
+	it("announces subagents:ready at construction and after /reload", async () => {
+		const bus = createEventBus();
+		let ready = 0;
+		bus.on("subagents:ready", () => {
+			ready++;
+		});
+		const harness = await parent(bus);
+		const afterBuild = ready;
+		expect(afterBuild).toBeGreaterThanOrEqual(1);
+		await harness.session.reload();
+		expect(ready).toBeGreaterThan(afterBuild);
+	});
+
+	it("leaves the bus when the session is disposed (D21)", async () => {
+		const bus = createEventBus();
+		const harness = await parent(bus);
+		harness.session.dispose();
+		expect(await ping(bus)).toBeUndefined();
+	});
+});
+
+/** Pings over the bus; resolves to the reply, or undefined when nothing answers within 100 ms. */
+function ping(bus: EventBus): Promise<unknown> {
+	const requestId = `probe-${Math.random().toString(36).slice(2)}`;
+	return new Promise((resolve) => {
+		const timer = setTimeout(() => {
+			unsubscribe();
+			resolve(undefined);
+		}, 100);
+		const unsubscribe = bus.on(`subagents:rpc:ping:reply:${requestId}`, (reply) => {
+			clearTimeout(timer);
+			unsubscribe();
+			resolve(reply);
+		});
+		bus.emit("subagents:rpc:ping", { requestId });
+	});
+}
