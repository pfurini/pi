--- /dev/null
+++ b/packages/coding-agent/src/core/fork-builtins/subagents/service.ts
@@ -0,0 +1,104 @@
+/**
+ * Fork-owned probe: the per-session subagent service (D18, D21, D22, D25).
+ * One service per parent `AgentSession`, kept in a WeakMap so a `/reload` that rebuilds the
+ * base tools finds the same service. The parent's `dispose()` ends every child through the
+ * per-session cleanup hook.
+ */
+import { registerSessionResourceCleanup } from "@earendil-works/pi-ai";
+import type { AgentSession } from "../../agent-session.ts";
+import type { LoadExtensionsResult } from "../../extensions/types.ts";
+import { DefaultResourceLoader } from "../../resource-loader.ts";
+import { createAgentSession } from "../../sdk.ts";
+import { SessionManager } from "../../session-manager.ts";
+import { SettingsManager } from "../../settings-manager.ts";
+
+export interface SpawnRequest {
+	prompt: string;
+	cwd: string;
+	/** Tool names the child must not see. */
+	excludeTools: string[];
+}
+
+export interface ChildHandle {
+	session: AgentSession;
+	loader: DefaultResourceLoader;
+	done: Promise<string>;
+}
+
+/** Drops every inline built-in (`<inline:name>`) from a child loader's extension set. */
+function dropInlineBuiltIns(base: LoadExtensionsResult): LoadExtensionsResult {
+	return { ...base, extensions: base.extensions.filter((extension) => !extension.path.startsWith("<inline:")) };
+}
+
+export class SubagentService {
+	readonly children = new Set<AgentSession>();
+	private readonly parent: AgentSession;
+	private readonly agentDir: string;
+	private readonly unregisterCleanup: () => void;
+	private disposed = false;
+
+	constructor(parent: AgentSession, agentDir: string) {
+		this.parent = parent;
+		this.agentDir = agentDir;
+		const parentId = parent.sessionId;
+		this.unregisterCleanup = registerSessionResourceCleanup((sessionId) => {
+			if (sessionId === parentId) this.dispose();
+		});
+	}
+
+	get isDisposed(): boolean {
+		return this.disposed;
+	}
+
+	async spawn(request: SpawnRequest): Promise<ChildHandle> {
+		const loader = new DefaultResourceLoader({
+			cwd: request.cwd,
+			agentDir: this.agentDir,
+			noSkills: true,
+			noPromptTemplates: true,
+			noThemes: true,
+			noContextFiles: true,
+			extensionsOverride: dropInlineBuiltIns,
+		});
+		await loader.reload();
+		const { session } = await createAgentSession({
+			cwd: request.cwd,
+			agentDir: this.agentDir,
+			modelRuntime: this.parent.modelRuntime,
+			model: this.parent.model,
+			sessionManager: SessionManager.inMemory(request.cwd),
+			settingsManager: SettingsManager.inMemory(),
+			resourceLoader: loader,
+			excludeTools: request.excludeTools,
+		});
+		await session.bindExtensions({});
+		this.children.add(session);
+		const done = session.prompt(request.prompt).then(() => {
+			const last = session.messages.filter((message) => message.role === "assistant").at(-1);
+			const content = last && "content" in last ? last.content : [];
+			return Array.isArray(content)
+				? content.map((part) => (part.type === "text" ? part.text : "")).join("")
+				: String(content);
+		});
+		return { session, loader, done };
+	}
+
+	dispose(): void {
+		if (this.disposed) return;
+		this.disposed = true;
+		this.unregisterCleanup();
+		for (const child of this.children) child.dispose();
+		this.children.clear();
+	}
+}
+
+const services = new WeakMap<AgentSession, SubagentService>();
+
+export function subagentServiceFor(session: AgentSession, agentDir: string): SubagentService {
+	let service = services.get(session);
+	if (!service) {
+		service = new SubagentService(session, agentDir);
+		services.set(session, service);
+	}
+	return service;
+}
