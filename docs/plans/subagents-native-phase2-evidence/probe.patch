@@ -0,0 +1,34 @@
+/**
+ * Fork-owned: the `Agent` tool's call and result rows (probe). `base-tools.ts` attaches them to the
+ * headless definition, so `tools/` imports no presentation code. The definition's `description` and
+ * `parameters` are lazy getters that read the session; attaching in place keeps registration from
+ * reading it.
+ */
+import { Text } from "@earendil-works/pi-tui";
+import type { ToolDefinition } from "../../../extensions/types.ts";
+
+interface AgentCallArgs {
+	description?: string;
+	subagent_type?: string;
+}
+
+function textOf(content: unknown): string {
+	return Array.isArray(content)
+		? content.map((part) => (part?.type === "text" && typeof part.text === "string" ? part.text : "")).join("")
+		: "";
+}
+
+/** Sets `renderCall` and `renderResult` on `definition` in place and returns it. */
+export function withAgentToolRenderers(definition: ToolDefinition): ToolDefinition {
+	definition.renderCall = (args, theme) => {
+		const { description, subagent_type } = args as AgentCallArgs;
+		const title = theme.fg("toolTitle", theme.bold(subagent_type ?? "Agent"));
+		return new Text(description ? `${title}  ${theme.fg("muted", description)}` : title, 0, 0);
+	};
+	definition.renderResult = (result, { expanded }, theme) => {
+		const lines = textOf(result.content).split("\n");
+		const shown = expanded ? lines : lines.slice(0, 1);
+		return new Text(theme.fg("dim", shown.join("\n")), 0, 0);
+	};
+	return definition;
+}
