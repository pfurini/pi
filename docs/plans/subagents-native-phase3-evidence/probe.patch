+/**
+ * Fork-owned: the `@` roster (phase 3 probe) over a fake service: skill-bundled agents stay out of it,
+ * running or evicted (ADR-0008).
+ */
+import { describe, expect, it } from "vitest";
+import type { AgentDefinition } from "../../../src/core/fork-builtins/subagents/definitions/types.ts";
+import type { SubagentView } from "../../../src/core/fork-builtins/subagents/service/records.ts";
+import type { Tombstone } from "../../../src/core/fork-builtins/subagents/service/retention.ts";
+import type { SubagentService } from "../../../src/core/fork-builtins/subagents/service/service.ts";
+import { mentionRoster } from "../../../src/core/fork-builtins/subagents/ui/mentions.ts";
+
+function definition(name: string, hidden: boolean): AgentDefinition {
+	return { name, description: `${name} agent.`, enabled: true, hidden } as unknown as AgentDefinition;
+}
+
+function fakeService(views: SubagentView[], tombstones: Tombstone[], definitions: AgentDefinition[]): SubagentService {
+	return {
+		registry: { agents: new Map(definitions.map((entry) => [entry.name, entry])) },
+		list: () => views,
+		listTombstones: () => tombstones,
+	} as unknown as SubagentService;
+}
+
+describe("the @ roster", () => {
+	it("lists no skill-bundled agent, running or evicted", () => {
+		const skill = definition("skill:worker", true);
+		const plain = definition("worker", false);
+		const running = {
+			id: "a",
+			type: skill.name,
+			definition: skill,
+			handle: "skill-worker",
+			status: "running",
+			description: "skill work",
+			startedAt: 1,
+		} as unknown as SubagentView;
+		const evicted: Tombstone = {
+			handle: "skill-worker-2",
+			id: "b",
+			type: skill.name,
+			description: "old skill work",
+			sessionFile: "/nowhere.jsonl",
+			completedAt: 2,
+		};
+		const rows = mentionRoster(fakeService([running], [evicted], [skill, plain]));
+		expect(rows.map((row) => row.handle)).toEqual(["worker"]);
+	});
+});
