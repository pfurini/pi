++/**
++ * Fork-owned registry of built-in extensions. A distribution entry registers the
++ * packages it ships; every DefaultResourceLoader constructed afterwards in the same
++ * module graph loads them, including under `noExtensions`.
++ *
++ * The ported packages ship TypeScript source, so each one loads through the same
++ * jiti-backed module loader that loads any extension path.
++ */
++import { loadExtensionFactoryFromPath } from "./extensions/loader.ts";
++import type { ExtensionFactory, InlineExtension } from "./extensions/types.ts";
++
++export interface ForkBuiltInPackage {
++	name: string;
++	entryPath: string;
++}
++
++const registered: InlineExtension[] = [];
++
++function packageFactory(builtIn: ForkBuiltInPackage): ExtensionFactory {
++	return async (pi) => {
++		const factory = await loadExtensionFactoryFromPath(builtIn.entryPath);
++		if (!factory) {
++			throw new Error(`Built-in extension ${builtIn.name} does not export a factory`);
++		}
++		await factory(pi);
++	};
++}
++
++export function registerForkBuiltInPackages(builtIns: readonly ForkBuiltInPackage[]): void {
++	for (const builtIn of builtIns) {
++		if (registered.some((entry) => typeof entry !== "function" && entry.name === builtIn.name)) continue;
++		registered.push({ name: builtIn.name, factory: packageFactory(builtIn), hidden: true });
++	}
++}
++
++export function forkBuiltInExtensions(): InlineExtension[] {
++	return [...registered];
++}
