+import { Value } from "typebox/value";
+import { describe, expect, it } from "vitest";
+import {
+	isQuestionnaireResult,
+	MAX_HEADER_LENGTH,
+	MAX_LABEL_LENGTH,
+	MAX_OPTION_LABEL_LENGTH,
+	MAX_OPTIONS,
+	MAX_QUESTIONS,
+	MIN_OPTIONS,
+	type QuestionAnswer,
+	type QuestionData,
+	type QuestionnaireResult,
+	QuestionParamsSchema,
+	QuestionsSchema,
