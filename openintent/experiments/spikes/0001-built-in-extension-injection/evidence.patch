@@ -0,0 +1,54 @@
+// C3 detail: separates the two readings of "tool registry" the frozen C3 leaves open.
+//   extension level: the tools the loaded built-in registered (resource loader extensions);
+//   session level:   AgentSession.getAllTools(), which the `tools` allowlist filters.
+// Also tries to enable the non-allowlisted built-in at runtime.
+// Usage: node spike/harness/c3-registry-detail.mjs <label>   (run from the worktree root)
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const label = process.argv[2];
+if (!label) throw new Error("candidate label required");
+const root = process.cwd();
+const sdkEntry = process.argv[3] ?? join(root, "packages/coding-agent/dist/index.js");
+const out = join(root, "spike/runs", `${label}-C3-registry-detail.json`);
+const record = { label, sdkEntry, sessions: [] };
+
+const agentDir = mkdtempSync(join(tmpdir(), "spike-0001-agent-"));
+const cwd = mkdtempSync(join(tmpdir(), "spike-0001-cwd-"));
+writeFileSync(join(agentDir, "settings.json"), '{\n  "packages": []\n}\n');
+const { createAgentSessionServices, createAgentSessionFromServices, SessionManager, SettingsManager } = await import(
+	pathToFileURL(sdkEntry).href
+);
+
+for (const tools of [["read"], ["read", "ask_user_question"]]) {
+	const services = await createAgentSessionServices({
+		cwd,
+		agentDir,
+		settingsManager: SettingsManager.inMemory({}),
+		resourceLoaderOptions: { noExtensions: true, noSkills: true, noPromptTemplates: true, noThemes: true, noContextFiles: true },
+	});
+	const { session } = await createAgentSessionFromServices({
+		services,
+		sessionManager: SessionManager.inMemory(),
+		model: services.modelRuntime.getModel("spike-fixture", "echo"),
+		tools,
+	});
+	const entry = {
+		allowlist: tools,
+		extensionLevel: services.resourceLoader
+			.getExtensions()
+			.extensions.map((e) => ({ path: e.path, tools: [...e.tools.keys()] })),
+		sessionLevelGetAllTools: session.getAllTools().map((t) => t.name),
+		activeBefore: session.getActiveToolNames(),
+	};
+	session.setActiveToolsByName(["read", "ask_user_question"]);
+	entry.activeAfterEnablingAtRuntime = session.getActiveToolNames();
+	record.sessions.push(entry);
+	console.log(JSON.stringify(entry));
+	session.dispose();
+}
+writeFileSync(out, `${JSON.stringify(record, null, "\t")}\n`);
+console.log(`raw: ${out}`);
+setTimeout(() => process.exit(), 200);
diff --git a/spike/harness/c4-direct-import.mjs b/spike/harness/c4-direct-import.mjs
