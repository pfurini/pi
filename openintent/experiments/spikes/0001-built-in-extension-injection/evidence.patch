+#!/usr/bin/env bash
+# C6: repeat C1's flow inside a fenced launch. The pty driver stays outside the fence;
+# `pi-fence run --profile general` wraps only the candidate's `pi`. The working directory is
+# the worktree, so the fence's implicit working-directory grant covers the build.
+# Precondition (operator-approved): ~/.pi/agent/settings.json lists no rpiv-mono package.
+# Usage: spike/harness/c6-fenced.sh <label> <bin>   (run from the worktree root)
+set -u
+label="${1:?candidate label}"
+bin="${2:?candidate bin}"
+fence_cli=/Users/paolof/Developer/ai/pi-fence/dist/cli/main.js
+out="$PWD/spike/runs/$label-C6-fenced.txt"
+script_json=$(mktemp /tmp/spike-0001-c6.XXXXXX)
+before=$(ls -1 "$HOME/.pi-fence/violations" | sort | tail -1)
+cat >"$script_json" <<EOF
+{
+  "command": ["node", "$fence_cli", "run", "--profile", "general", "--", "$(command -v node)", "$bin", "--no-extensions", "-e", "$PWD/spike/harness/scripted-provider.ts", "--model", "spike-script/scripted"],
+  "env": {},
+  "cwd": "$PWD",
+  "cols": 120,
+  "rows": 40,
+  "steps": [
+    {"until": "Trust project folder?", "timeout": 30},
+    {"screen": "trust prompt"},
+    {"key": "down"},
+    {"key": "down"},
+    {"key": "down"},
+    {"key": "down"},
+    {"screen": "trust prompt, Do not trust (this session only) selected"},
+    {"key": "enter"},
+    {"wait": 8},
+    {"screen": "startup"},
+    {"send": "Ask me the colour question."},
+    {"key": "enter"},
+    {"until": "Teal", "timeout": 40},
+    {"wait": 1},
+    {"screen": "questionnaire"},
+    {"key": "enter"},
+    {"until": "SPIKE-RECEIVED", "timeout": 40},
+    {"wait": 1},
+    {"screen": "after answer"}
+  ]
+}
+EOF
+{
+	echo "candidate: $label"
+	echo "bin: $bin"
+	echo "node: $(node -v) $(command -v node)"
+	echo "settings.json rpiv-mono entries: $(grep -c rpiv-mono "$HOME/.pi/agent/settings.json")"
+	uv run --quiet --with pyte python "$PWD/spike/harness/pty_drive.py" "$script_json"
+	sleep 2
+	after=$(ls -1 "$HOME/.pi-fence/violations" | sort | tail -1)
+	echo "===== violations journal (newest before: $before, newest after: $after)"
+	if [ "$after" != "$before" ]; then
+		echo "journal: $HOME/.pi-fence/violations/$after"
+		echo "lines: $(wc -l <"$HOME/.pi-fence/violations/$after")"
+		echo "--- entries naming the worktree, rpiv-mono or the Pi checkout"
+		grep -E "spike-0001|rpiv-mono|Developer/ai/pi[/\"]" "$HOME/.pi-fence/violations/$after" || echo "(none)"
+		echo "--- all entries"
+		cat "$HOME/.pi-fence/violations/$after"
+	else
+		echo "no new journal file"
+	fi
+} >"$out" 2>&1
+rm -f "$script_json"
+echo "$out"
diff --git a/spike/harness/pty_drive.py b/spike/harness/pty_drive.py
new file mode 100644
index 000000000..d13fde4da
--- /dev/null
+++ b/spike/harness/pty_drive.py
@@ -0,0 +1,95 @@
+"""Spike 0001 harness: drive an interactive program in a pseudo-terminal and render screens.
+
+Usage: uv run --with pyte python spike/harness/pty_drive.py <script.json>
+
+The script JSON holds: command (argv list), env (extra variables), cwd, cols, rows, and
+steps. Each step is {"wait": seconds}, {"send": text}, {"key": "enter"|"down"|"escape"|"ctrl-c"},
+{"screen": label} to print the rendered screen, or {"until": text, "timeout": seconds}
+to wait until the rendered screen contains text.
+"""
+
+import fcntl
+import json
+import os
+import pty
+import select
+import signal
+import struct
+import sys
+import termios
+import time
+
+import pyte
+
+KEYS = {"enter": "\r", "down": "\x1b[B", "up": "\x1b[A", "escape": "\x1b", "ctrl-c": "\x03", "tab": "\t"}
+
+
+def main() -> int:
+    with open(sys.argv[1], encoding="utf-8") as handle:
+        script = json.load(handle)
+    cols, rows = script.get("cols", 120), script.get("rows", 40)
+    screen = pyte.Screen(cols, rows)
+    stream = pyte.ByteStream(screen)
+    env = {**os.environ, **script.get("env", {}), "TERM": "xterm-256color", "COLUMNS": str(cols), "LINES": str(rows)}
+
+    pid, fd = pty.fork()
+    if pid == 0:
+        os.chdir(script["cwd"])
+        os.execvpe(script["command"][0], script["command"], env)
+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
+
+    def pump(seconds: float) -> None:
+        deadline = time.monotonic() + seconds
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                return
+            ready, _, _ = select.select([fd], [], [], min(remaining, 0.1))
+            if ready:
+                try:
+                    data = os.read(fd, 65536)
+                except OSError:
+                    return
+                if not data:
+                    return
+                stream.feed(data)
+                # Answer cursor-position and device-attribute queries so the TUI does not stall.
+                if b"\x1b[6n" in data:
+                    os.write(fd, f"\x1b[{screen.cursor.y + 1};{screen.cursor.x + 1}R".encode())
+                if b"\x1b[c" in data:
+                    os.write(fd, b"\x1b[?62;22c")
+
+    def rendered() -> str:
+        return "\n".join(line.rstrip() for line in screen.display).rstrip()
+
+    for step in script["steps"]:
+        if "wait" in step:
+            pump(step["wait"])
+        elif "send" in step:
+            os.write(fd, step["send"].encode())
+            pump(0.3)
+        elif "key" in step:
+            os.write(fd, KEYS[step["key"]].encode())
+            pump(0.3)
+        elif "until" in step:
+            deadline = time.monotonic() + step.get("timeout", 10)
+            found = False
+            while time.monotonic() < deadline:
+                pump(0.2)
+                if step["until"] in rendered():
+                    found = True
+                    break
+            print(f"===== until {step['until']!r}: {'found' if found else 'TIMEOUT'}")
+        elif "screen" in step:
+            print(f"===== screen: {step['screen']}")
+            print(rendered())
+    try:
+        os.kill(pid, signal.SIGTERM)
+    except ProcessLookupError:
+        pass
+    pump(0.5)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/spike/harness/scripted-provider.ts b/spike/harness/scripted-provider.ts
new file mode 100644
index 000000000..9ac4b4bfa
--- /dev/null
+++ b/spike/harness/scripted-provider.ts
@@ -0,0 +1,57 @@
+/**
+ * Spike 0001 harness apparatus, loaded with `-e`. Registers the provider
+ * `spike-script` whose model `scripted` plays two turns:
+ *   1. it calls `ask_user_question` with one single-select question;
+ *   2. it records the tool result it received into $SPIKE_LOG and replies with it.
+ * It never calls a real model.
+ */
+import { appendFileSync } from "node:fs";
+import { fauxAssistantMessage, fauxProvider, fauxText, fauxToolCall } from "@earendil-works/pi-ai";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+
+// pi-fence drops unknown environment names, so a fenced run (C6) falls back to a log under
+// the working directory, which the fence grants for writing.
+const logPath = process.env.SPIKE_LOG ?? `${process.cwd()}/spike/runs/C6-scripted-${Date.now()}.jsonl`;
+
+function record(event: string, data: unknown): void {
+	appendFileSync(logPath, `${JSON.stringify({ at: new Date().toISOString(), event, data })}\n`);
+}
+
+export default function (pi: ExtensionAPI) {
+	const faux = fauxProvider({
+		api: "spike-script-api",
+		provider: "spike-script",
+		models: [{ id: "scripted", name: "Spike scripted" }],
+	});
+	faux.setResponses([
+		(context) => {
+			record("request-1", { messageRoles: context.messages.map((m) => m.role) });
+			return fauxAssistantMessage(
+				[
+					fauxToolCall("ask_user_question", {
+						questions: [
+							{
+								question: "Which colour should the spike pick?",
+								header: "Colour",
+								multiSelect: false,
+								options: [
+									{ label: "Teal", description: "The first option." },
+									{ label: "Amber", description: "The second option." },
+								],
+							},
+						],
+					}),
+				],
+				{ stopReason: "toolUse" },
+			);
+		},
+		(context) => {
+			const toolResults = context.messages.filter((m) => m.role === "toolResult");
+			record("request-2", { toolResults });
+			const last = toolResults.at(-1);
+			const text = last ? JSON.stringify(last.content) : "no tool result";
+			return fauxAssistantMessage(fauxText(`SPIKE-RECEIVED ${text}`));
+		},
+	]);
+	pi.registerProvider(faux.provider);
+}
