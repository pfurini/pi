@@ -0,0 +1,26 @@
+/**
+ * Spike 0001 fixture built-in. Registers the provider `spike-fixture` with the model
+ * `echo`, which replies `FIXTURE-ECHO: <last user text>` and never calls a network.
+ */
+import { type FauxResponseFactory, fauxAssistantMessage, fauxProvider, fauxText } from "@earendil-works/pi-ai";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+
+export default function (pi: ExtensionAPI) {
+	const faux = fauxProvider({
+		api: "spike-fixture-api",
+		provider: "spike-fixture",
+		models: [{ id: "echo", name: "Spike fixture echo" }],
+	});
+	const echo: FauxResponseFactory = (context) => {
+		faux.appendResponses([echo]);
+		const lastUser = [...context.messages].reverse().find((message) => message.role === "user");
+		const content = lastUser?.content;
+		const text =
+			typeof content === "string"
+				? content
+				: (content ?? []).map((block) => ("text" in block ? block.text : "")).join("");
+		return fauxAssistantMessage(fauxText(`FIXTURE-ECHO: ${text}`));
+	};
+	faux.setResponses([echo]);
+	pi.registerProvider(faux.provider);
+}
