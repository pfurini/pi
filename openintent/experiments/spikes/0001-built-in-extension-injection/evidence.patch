@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+# C7: merge hygiene and byte parity for the candidate currently in the worktree.
+# Usage: spike/c7-measure.sh <label>   (run from the worktree root)
+set -u
+label="${1:?candidate label}"
+base=eda5a402a
+upstream_ref=earendil-works/main
+rpiv_repo=/Users/paolof/Developer/ai/rpiv-mono
+rpiv_commit=8403bb09464e956d01cb4caf957980aba670b5f2
+ported_dir=packages/builtins/rpiv-ask-user-question
+
+echo "candidate: $label"
+echo "base: $(git rev-parse "$base")  upstream ref: $upstream_ref $(git rev-parse "$upstream_ref")"
+echo
+echo "== per-file numstat against $base (tracked and untracked, spike/ and openintent/ excluded)"
+git add -N . >/dev/null 2>&1
+added_total=0
+removed_total=0
+while IFS=$'\t' read -r added removed path; do
+	case "$path" in
+		spike/*|openintent/*) continue ;;
+		package-lock.json|packages/coding-agent/npm-shrinkwrap.json|packages/coding-agent/install-lock/*) owned="generated-excluded" ;;
+		*)
+			if git cat-file -e "$upstream_ref:$path" 2>/dev/null; then owned="upstream-owned"; else owned="fork-owned"; fi
+			;;
+	esac
+	printf '%-20s +%-5s -%-5s %s\n' "$owned" "$added" "$removed" "$path"
+	if [ "$owned" = "upstream-owned" ]; then
+		added_total=$((added_total + added))
+		removed_total=$((removed_total + removed))
+	fi
+done < <(git diff --numstat "$base" -- . ':(exclude)spike' ':(exclude)openintent')
+git reset -q >/dev/null 2>&1
+echo
+echo "UPSTREAM-OWNED TOTAL: added=$added_total removed=$removed_total (limit: added<=15, removed=0)"
+echo
+echo "== byte parity: $ported_dir vs rpiv-mono $rpiv_commit"
+tmp=$(mktemp -d)
+git -C "$rpiv_repo" archive "$rpiv_commit" packages/rpiv-ask-user-question | tar -x -C "$tmp"
+if diff -r "$tmp/packages/rpiv-ask-user-question" "$ported_dir" >"$tmp/parity.txt" 2>&1; then
+	echo "no difference"
+else
+	cat "$tmp/parity.txt"
+fi
+echo "== file modes"
+(cd "$tmp/packages/rpiv-ask-user-question" && find . -type f -exec stat -f '%Lp %N' {} + | sort) >"$tmp/modes-fork.txt"
+(cd "$ported_dir" && find . -type f ! -name UPSTREAM.json -exec stat -f '%Lp %N' {} + | sort) >"$tmp/modes-pi.txt"
+if diff "$tmp/modes-fork.txt" "$tmp/modes-pi.txt"; then echo "modes equal"; fi
+rm -rf "$tmp"
