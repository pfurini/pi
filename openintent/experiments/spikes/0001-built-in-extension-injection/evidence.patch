+#!/usr/bin/env bash
+# C1: interactive CLI. Drives the bundled `pi` in a pseudo-terminal with an agent directory
+# whose settings.json lists no package, under --no-extensions, and answers the questionnaire
+# with Enter (first option, "Teal").
+# Usage: spike/harness/c1-tui.sh <label>   (run from the worktree root)
+set -u
+label="${1:?candidate label}"
+bin="${PI_BIN:-$PWD/packages/coding-agent/dist/bundle/cli.js}"
+run_dir="$PWD/spike/runs"
+out="$run_dir/$label-C1-tui.txt"
+log="$run_dir/$label-C1-scripted.jsonl"
+agent_dir=$(mktemp -d /tmp/spike-0001-agent.XXXXXX)
+work_dir=$(mktemp -d /tmp/spike-0001-cwd.XXXXXX)
+printf '{\n  "packages": []\n}\n' >"$agent_dir/settings.json"
+rm -f "$log"
+script_json=$(mktemp /tmp/spike-0001-c1.XXXXXX)
+cat >"$script_json" <<EOF
+{
+  "command": ["node", "$bin", "--no-extensions", "-e", "$PWD/spike/harness/scripted-provider.ts", "--model", "spike-script/scripted"],
+  "env": {"PI_CODING_AGENT_DIR": "$agent_dir", "SPIKE_LOG": "$log"},
+  "cwd": "$work_dir",
+  "cols": 120,
+  "rows": 40,
+  "steps": [
+    {"wait": 8},
+    {"screen": "startup"},
+    {"send": "Ask me the colour question."},
+    {"key": "enter"},
+    {"until": "Teal", "timeout": 20},
+    {"wait": 1},
+    {"screen": "questionnaire"},
+    {"key": "enter"},
+    {"until": "SPIKE-RECEIVED", "timeout": 20},
+    {"wait": 1},
+    {"screen": "after answer"}
+  ]
+}
+EOF
+{
+	echo "candidate: $label"
+	echo "bin: $bin"
+	echo "agent dir: $agent_dir (settings.json lists no package)"
+	echo "cwd: $work_dir"
+	uv run --quiet --with pyte python "$PWD/spike/harness/pty_drive.py" "$script_json"
+	echo "===== scripted provider log"
