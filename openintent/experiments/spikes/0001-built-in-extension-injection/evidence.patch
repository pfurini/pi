+		const BYTE_ALT_O = "\x1bo"; // ESC + 'o' — legacy encoding for Alt+O
+		expect(routeKey(BYTE_ALT_O, makeState(), makeRuntime({ collapseKey: "alt+o" }))).toEqual({
+			kind: "toggle_collapsed",
