@@ -0,0 +1,38 @@
+// Supporting probe for C4: a consumer that imports `@earendil-works/pi-coding-agent` by bare
+// specifier (as pi-subagents and the OpenIntent worker do), optionally after a fork entry
+// was imported in the same process.
+// Usage: node spike/harness/c4-direct-import.mjs <label> <mode>
+//   mode "bare-only":        import the SDK by bare specifier and nothing else;
+//   mode "after-entry=PATH": import PATH first (a fork entry), then the SDK by bare specifier.
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const [label, mode] = process.argv.slice(2);
+if (!label || !mode) throw new Error("usage: <label> <bare-only|after-entry=PATH>");
+const root = process.cwd();
+const tag = mode === "bare-only" ? "bare-only" : "after-entry";
+const out = join(root, "spike/runs", `${label}-C4-direct-${tag}.json`);
+if (mode.startsWith("after-entry=")) {
+	await import(pathToFileURL(resolve(mode.slice("after-entry=".length))).href);
+}
+const specifier = "@earendil-works/pi-coding-agent";
+const resolved = import.meta.resolve(specifier);
+const { DefaultResourceLoader } = await import(specifier);
+const agentDir = mkdtempSync(join(tmpdir(), "spike-0001-agent-"));
+const cwd = mkdtempSync(join(tmpdir(), "spike-0001-cwd-"));
+writeFileSync(join(agentDir, "settings.json"), '{\n  "packages": []\n}\n');
+const loader = new DefaultResourceLoader({ cwd, agentDir, noExtensions: true });
+await loader.reload();
+const loaded = loader.getExtensions();
+const record = {
+	label,
+	mode,
+	resolved,
+	extensions: loaded.extensions.map((e) => ({ path: e.path, tools: [...e.tools.keys()] })),
+	errors: loaded.errors,
+};
+writeFileSync(out, `${JSON.stringify(record, null, "\t")}\n`);
+console.log(JSON.stringify(record));
+setTimeout(() => process.exit(), 200);
