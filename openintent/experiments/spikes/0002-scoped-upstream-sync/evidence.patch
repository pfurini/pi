+#!/usr/bin/env bash
+# Candidate B, scratch merge. Run from the Pi worktree root.
+# Usage: spike/sync-b.sh <source repo> <source subdir or ""> <recorded base> <new commit> <package dir>
+# A temporary repository holds base, ours (the Pi directory) and theirs (the new upstream tree).
+# `git merge` runs there with default rename detection; its files replace the Pi directory.
+# Prints Git's own output and exits with `git merge`'s own exit code; it maps nothing.
+set -u
+. "$(dirname "$0")/lib.sh"
+src=$1 sub=$2 base=$3 new=$4 dir=$5
+scratch=$(mktemp -d /tmp/spike-0002-scratch.XXXXXX)
+G=(git -C "$scratch" -c user.name=spike -c user.email=spike@local -c commit.gpgsign=false -c core.hooksPath=/dev/null)
+git init -q -b ours "$scratch"
+clear_tree() { find "$scratch" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +; }
+
+extract "$src" "$base" "$sub" "$scratch"
+"${G[@]}" add -A && "${G[@]}" commit -q -m base
+"${G[@]}" branch -q theirs
+
+clear_tree
+(cd "$dir" && tar -cf - .) | (cd "$scratch" && tar -xf -)
+"${G[@]}" add -A && "${G[@]}" commit -q --allow-empty -m ours
+
+"${G[@]}" switch -q theirs
+clear_tree
+extract "$src" "$new" "$sub" "$scratch"
+"${G[@]}" add -A && "${G[@]}" commit -q --allow-empty -m theirs
+"${G[@]}" switch -q ours
+
+"${G[@]}" merge theirs
+code=$?
+echo "git-merge-exit: $code"
+echo "unmerged:"
+"${G[@]}" diff --name-only --diff-filter=U
+
+find "$dir" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
+(cd "$scratch" && tar -cf - --exclude=./.git .) | (cd "$dir" && tar -xf -)
+echo "scratch: $scratch"
+exit "$code"
