+#!/usr/bin/env bash
+# Candidate A, three-way apply. Run from the Pi worktree root.
+# Usage: spike/sync-a.sh <source repo> <source subdir or ""> <recorded base> <new commit> <package dir>
+# Prints Git's own output and exits with `git apply`'s own exit code; it maps nothing.
+set -u
+src=$1 sub=$2 base=$3 new=$4 dir=$5
+patch=$(mktemp /tmp/spike-0002-patch.XXXXXX)
+# The new commit's objects, and with them the base blobs, enter the object store with no ref.
+git fetch --quiet --no-tags --no-write-fetch-head "$src" "$new" "$base"
+if [ -n "$sub" ]; then
+	git -C "$src" diff --binary -M --relative="$sub/" "$base" "$new" >"$patch"
+else
+	git -C "$src" diff --binary -M "$base" "$new" >"$patch"
+fi
+echo "patch-bytes: $(wc -c <"$patch" | tr -d ' ')"
+git apply -3 --directory="$dir" "$patch"
+code=$?
+echo "git-apply-exit: $code"
+echo "unmerged:"
+git diff --name-only --diff-filter=U -- "$dir" | sed "s|^$dir/||"
+rm -f "$patch"
+exit "$code"
