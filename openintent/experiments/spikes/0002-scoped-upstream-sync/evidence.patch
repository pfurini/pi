diff --git a/spike/replay.sh b/spike/replay.sh
new file mode 100755
index 000000000..1c7171156
--- /dev/null
+++ b/spike/replay.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# Replays one fork merge through one candidate and compares with Git's automatic result.
+# Usage: spike/replay.sh <a|b> <case> <source repo> <subdir or ""> <merge commit> [uptodate]
+# The Pi side starts as the merge's first parent; the sync goes from the merge base to the
+# merge's second parent. With "uptodate", the sync targets the base itself.
+set -u
+. "$(dirname "$0")/lib.sh"
+cand=$1 case=$2 src=$3 sub=$4 merge=$5 mode=${6:-}
+p1=$(git -C "$src" rev-parse "$merge^1")
+p2=$(git -C "$src" rev-parse "$merge^2")
+base=$(git -C "$src" merge-base "$p1" "$p2")
+new=$p2
+[ "$mode" = "uptodate" ] && new=$base
+dir=packages/builtins/replay-$case-$cand
+out=spike/runs/$cand-$case.txt
+work=$(mktemp -d /tmp/spike-0002-work.XXXXXX)
+{
+	echo "candidate=$cand case=$case source=$src subdir=${sub:-<root>} merge=$merge"
+	echo "p1=$p1 p2=$p2 base=$base new=$new"
+	echo "tty: stdin=$([ -t 0 ] && echo yes || echo no) stdout=$([ -t 1 ] && echo yes || echo no)"
+	refs_before=$(git for-each-ref | wc -l | tr -d ' ')
+	extract "$src" "$p1" "$sub" "$dir"
+	write_upstream_record "$dir" "$src" "$sub" "$base"
+	git add -A -f -- "$dir"
+	pi_commit "spike 0002: port $case for candidate $cand"
+	echo "===== sync"
+	start=$(date +%s)
+	"spike/sync-$cand.sh" "$src" "$sub" "$base" "$new" "$dir" </dev/null >"$work/sync.out" 2>&1
+	code=$?
+	cat "$work/sync.out"
+	echo "sync-exit=$code seconds=$(($(date +%s) - start))"
+	echo "refs: before=$refs_before after=$(git for-each-ref | wc -l | tr -d ' ')"
+	echo "===== containment: status entries outside $dir"
+	outside=$(git status --porcelain | awk -v d="$dir/" '{p=substr($0,4); if (index(p,d)!=1 && index(p,"spike/")!=1) print}')
+	if [ -z "$outside" ]; then echo "(none)"; else echo "$outside"; fi
+	if [ "$mode" != "uptodate" ]; then
+		echo "===== automatic result"
+		tree=$(automatic_result "$src" "$p1" "$p2" "$sub" "$work/auto" "$work/auto-conflicts")
+		echo "merge-tree: $tree"
+		sed -n '/^unmerged:/,/^scratch:/p' "$work/sync.out" | sed '1d;/^scratch:/d;/^$/d' | sort >"$work/cand-conflicts"
+		echo "expected conflicted: $(tr '\n' ' ' <"$work/auto-conflicts")"
+		echo "candidate conflicted: $(tr '\n' ' ' <"$work/cand-conflicts")"
+		if cmp -s "$work/auto-conflicts" "$work/cand-conflicts"; then echo "CONFLICT-SET: EQUAL"; else echo "CONFLICT-SET: DIFFERENT"; fi
+		echo "===== comparison against the automatic result (conflicted paths: presence and mode only)"
+		compare_dirs "$work/auto" "$dir" "$work/auto-conflicts"
+	fi
+	echo "===== cleanup"
+	git rm -r -q -f -- "$dir" >/dev/null 2>&1
+	rm -rf "$dir"
+	pi_commit "spike 0002: drop $case for candidate $cand" 2>/dev/null || true
+	echo "status after cleanup: $(git status --porcelain -- packages | wc -l | tr -d ' ') entries under packages/"
+} >"$out" 2>&1
+rm -rf "$work"
+echo "$out"
