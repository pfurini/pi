index 000000000..9e7f2d02f
--- /dev/null
+++ b/spike/rename.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# C3: pi-hashline-edit-pro renames prompts/replace-flat.md to prompts/replace.md in cbd5fce.
+# The Pi side carries one synthetic line in prompts/replace-flat.md, placed after a line
+# upstream leaves unchanged, two lines clear of upstream's nearest edit.
+# Usage: spike/rename.sh <a|b>
+set -u
+. "$(dirname "$0")/lib.sh"
+cand=$1
+src=/Users/paolof/Developer/ai/pi-hashline-edit-pro
+new=$(git -C "$src" rev-parse cbd5fce)
+base=$(git -C "$src" rev-parse "cbd5fce^")
+dir=packages/builtins/rename-$cand
+out=spike/runs/$cand-C3-rename.txt
+line="SPIKE-0002 synthetic Pi-side edit: this line must survive the upstream rename."
+work=$(mktemp -d /tmp/spike-0002-work.XXXXXX)
+{
+	echo "candidate=$cand base=$base new=$new"
+	extract "$src" "$base" "" "$dir"
+	write_upstream_record "$dir" "$src" "" "$base"
+	awk -v l="$line" '{print} /^⚠️ Common mistake/ && !done {print l; done=1}' "$dir/prompts/replace-flat.md" >"$work/edited"
+	cp "$work/edited" "$dir/prompts/replace-flat.md"
+	echo "synthetic line inserted: $(grep -c "$line" "$dir/prompts/replace-flat.md")"
+	git add -A -f -- "$dir"
+	pi_commit "spike 0002: rename port with a Pi-side edit for candidate $cand"
+	"spike/sync-$cand.sh" "$src" "" "$base" "$new" "$dir" </dev/null >"$work/sync.out" 2>&1
+	echo "sync-exit=$?"
+	cat "$work/sync.out"
+	echo "===== checks"
+	if [ -e "$dir/prompts/replace-flat.md" ]; then echo "OLD-PATH: PRESENT"; else echo "OLD-PATH: ABSENT"; fi
+	if [ -e "$dir/prompts/replace.md" ]; then echo "NEW-PATH: PRESENT"; else echo "NEW-PATH: ABSENT"; fi
+	echo "synthetic line in prompts/replace.md: $(grep -c "$line" "$dir/prompts/replace.md" 2>/dev/null || echo 0)"
+	git -C "$src" show "$new:prompts/replace.md" >"$work/upstream-replace.md"
+	# perl removes exactly the synthetic line and keeps the file's final-newline state, which grep would change.
+	SPIKE_LINE="$line" perl -0pe 's/^\Q$ENV{SPIKE_LINE}\E\n//m' "$dir/prompts/replace.md" >"$work/without-line" 2>/dev/null
+	if cmp -s "$work/upstream-replace.md" "$work/without-line"; then echo "UPSTREAM-CHANGE: KEPT (replace.md minus the synthetic line equals upstream's replace.md)"; else echo "UPSTREAM-CHANGE: DIFFERENT"; diff "$work/upstream-replace.md" "$work/without-line" | head -20; fi
+	echo "git status for the two paths:"
+	git status --porcelain -- "$dir/prompts/replace-flat.md" "$dir/prompts/replace.md"
+	echo "===== containment: status entries outside $dir"
+	outside=$(git status --porcelain | awk -v d="$dir/" '{p=substr($0,4); if (index(p,d)!=1 && index(p,"spike/")!=1) print}')
+	if [ -z "$outside" ]; then echo "(none)"; else echo "$outside"; fi
+	echo "===== cleanup"
+	git rm -r -q -f -- "$dir" >/dev/null 2>&1
+	rm -rf "$dir"
