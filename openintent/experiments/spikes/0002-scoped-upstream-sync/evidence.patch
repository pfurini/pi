+| C7 | Holds for both rpiv merges. | proved | `runs/b-R10-e04fe7a4.txt`, `runs/b-R10-ce35c164.txt` |
+
+Supporting conclusions, shared by both candidates:
+
+- Only `64e3c25` among the frozen replay merges lies on the first-parent line of `personal`. The rest are upstream pull-request merges or side-branch merges reachable from `personal` (`runs/00-replay-provenance.txt`).
+- In R8, the first parents of `efff473` and `cd64b9f` do not descend from the previous chain merge, so R8 is not one downstream sync sequence (`runs/00-replay-provenance.txt`).
+- On the first-parent chain `c4b759f`, `60efeb9`, `64e3c25`, the step-3 recorded base is an ancestor of Git's base, 26 upstream commits older. Syncs through pull-request merges, such as `b0db315`, sit off the first-parent line. `c4b759f`'s committed resolution also adds a path outside its conflict set, which the harness does not copy (`runs/00-genuine-chain-ancestry.txt`, `runs/a-S-genuine-chain.txt`, `runs/b-S-genuine-chain.txt`). These runs are inconclusive about the method.
+- Pi's `.gitignore` entry `todo.md` matches `TODO.md` under `core.ignorecase=true`, so an unforced `git add` of a pi-claude-bridge port drops that file (`runs/00-gitignore-probe.txt`). The harness adds with `-f`.
+- Every run had no terminal and finished within 2 seconds; no Git process waited afterwards.
+- No subagent ran a harness. The coordinator read every claim from the run files named above.
diff --git a/spike/lib.sh b/spike/lib.sh
new file mode 100755
index 000000000..22e0de4a0
--- /dev/null
+++ b/spike/lib.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# Spike 0002 shared helpers. Source from the worktree root.
+
+# extract <repo> <treeish> <subdir or ""> <outdir>
+# Writes the tree's files into <outdir> through a private index and checkout-index, so
+# export-ignore attributes that `git archive` honours cannot drop files.
+extract() {
+	local repo=$1 treeish=$2 sub=$3 out=$4 idx spec
+	# checkout-index resolves --prefix inside <repo>, so a relative <outdir> must become absolute.
+	case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
+	idx=$(mktemp /tmp/spike-0002-idx.XXXXXX)
+	rm -f "$idx"
+	if [ -n "$sub" ]; then spec="$treeish:$sub"; else spec="$treeish^{tree}"; fi
+	mkdir -p "$out"
+	GIT_INDEX_FILE="$idx" git -C "$repo" read-tree "$spec"
+	GIT_INDEX_FILE="$idx" git -C "$repo" checkout-index -a -f --prefix="$out/"
+	rm -f "$idx"
+}
+
+# automatic_result <repo> <p1> <p2> <subdir or ""> <outdir> <conflicts-file>
+# Writes the tree `git merge-tree --write-tree` produces for the fork's merge, restricted to
+# <subdir>, and the conflicted paths relative to <subdir>.
+automatic_result() {
+	local repo=$1 p1=$2 p2=$3 sub=$4 out=$5 conflicts=$6 raw tree
+	raw=$(git -C "$repo" merge-tree --write-tree --name-only "$p1" "$p2")
+	tree=$(printf '%s\n' "$raw" | head -1)
+	printf '%s\n' "$raw" | sed -n '2,/^$/p' | sed '/^$/d' >"$conflicts.all"
+	if [ -n "$sub" ]; then
+		grep "^$sub/" "$conflicts.all" | sed "s|^$sub/||" | sort >"$conflicts" || true
+	else
+		sort "$conflicts.all" >"$conflicts"
+	fi
+	rm -f "$conflicts.all"
+	extract "$repo" "$tree" "$sub" "$out"
+	echo "$tree"
+}
+
+# compare_dirs <expected dir> <actual dir> <conflicted-list file>
+# Prints every difference in content, presence or mode, skipping content for conflicted paths
+# and ignoring UPSTREAM.json. Prints "IDENTICAL" when nothing differs.
+compare_dirs() {
+	local exp=$1 act=$2 conflicted=$3 diffs=0 f
+	local list
+	list=$( { (cd "$exp" && find . -type f -o -type l); (cd "$act" && find . -type f -o -type l); } | sed 's|^\./||' | grep -v '^UPSTREAM.json$' | sort -u)
+	while IFS= read -r f; do
+		[ -z "$f" ] && continue
+		if [ ! -e "$exp/$f" ] && [ ! -L "$exp/$f" ]; then echo "ONLY-IN-ACTUAL $f"; diffs=$((diffs + 1)); continue; fi
+		if [ ! -e "$act/$f" ] && [ ! -L "$act/$f" ]; then echo "ONLY-IN-EXPECTED $f"; diffs=$((diffs + 1)); continue; fi
+		if [ "$(stat -f '%Lp' "$exp/$f")" != "$(stat -f '%Lp' "$act/$f")" ]; then echo "MODE $f"; diffs=$((diffs + 1)); fi
+		if grep -qxF "$f" "$conflicted"; then continue; fi
+		if ! cmp -s "$exp/$f" "$act/$f"; then echo "CONTENT $f"; diffs=$((diffs + 1)); fi
+	done <<<"$list"
+	[ "$diffs" -eq 0 ] && echo "IDENTICAL"
+	return 0
+}
+
+# write_upstream_record <dir> <repo> <subdir> <base>
+write_upstream_record() {
+	printf '{\n\t"upstream": {\n\t\t"repository": "%s",\n\t\t"path": "%s",\n\t\t"base": "%s"\n\t}\n}\n' "$2" "$3" "$4" >"$1/UPSTREAM.json"
+}
+
+# recorded_base <dir>
+recorded_base() {
+	sed -n 's/.*"base": "\([0-9a-f]*\)".*/\1/p' "$1/UPSTREAM.json"
+}
+
+pi_commit() {
+	git -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -q --no-verify -m "$1"
+}
