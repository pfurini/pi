@@ -0,0 +1,29 @@
+# Spike 0002 code
+
+Harness for `openintent/experiments/spikes/0002-scoped-upstream-sync/report.md`. None of this is product code, and it is never merged: it exists only to answer that report's question and it lands beside the report as `evidence.patch`.
+
+## Files
+
+| Path | What it is |
+| --- | --- |
+| `runs/` | Raw output of every run, one file per run. `a-*` is candidate A, `b-*` candidate B, `00-*` shared probes, `*-attempt*` runs that exposed a harness defect. |
+| `findings/a.md`, `findings/b.md` | Per-candidate conclusions, each marked proved or inferred. |
+| `lib.sh` | Shared helpers: tree extraction through a private index, Git's automatic result through `git merge-tree --write-tree`, directory comparison, the upstream record. |
+| `sync-a.sh` | Candidate A: fetch without refs, `git diff --binary -M` in the source, `git apply -3 --directory` in Pi. Passes Git's exit code through. |
+| `sync-b.sh` | Candidate B: base, ours and theirs commits in a scratch repository under `/tmp`, `git merge`, files copied back. Passes Git's exit code through. |
+| `replay.sh` | C1, C2, C5, C6 and C7: ports a merge's first parent into Pi, syncs to its second parent, compares with the automatic result. |
+| `rename.sh` | C3: the pi-hashline-edit-pro rename with one synthetic Pi-side line. |
+| `chain.sh` | C4: chained syncs, reading and updating the recorded base. An optional label and merge list run a supporting chain. |
+| `run-all.sh` | Every frozen case for one candidate. |
+
+## Running it
+
+From the worktree root, with the three source checkouts at the commits the report's versions table names:
+
+```
+spike/run-all.sh a
+spike/run-all.sh b
+spike/chain.sh b S-genuine-chain c4b759f 60efeb9 64e3c25
+```
+
+No harness calls a model. Candidate A fetches objects into the Pi object store without creating a ref.
diff --git a/spike/chain.sh b/spike/chain.sh
new file mode 100755
index 000000000..1073aa7d0
--- /dev/null
+++ b/spike/chain.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+# C4: four chained syncs of pi-claude-bridge through one candidate, reading and updating the
+# recorded base each time. Between syncs the Pi side receives the fork's committed resolution
+# (for a conflicted step) and the fork's own commits up to the next merge's first parent.
+# Usage: spike/chain.sh <a|b> [label merge...]
+# With no label, the chain is the frozen R8 list and the run file is <cand>-C4-chain.txt.
+set -u
+. "$(dirname "$0")/lib.sh"
+cand=$1
+src=/Users/paolof/Developer/ai/pi-claude-bridge
+if [ $# -gt 1 ]; then
+	label=$2
+	shift 2
+	merges=("$@")
+else
+	label=C4-chain
+	merges=(1149b63 7edc676 efff473 cd64b9f)
+fi
+last=$((${#merges[@]} - 1))
+dir=packages/builtins/chain-$cand
+out=spike/runs/$cand-$label.txt
+work=$(mktemp -d /tmp/spike-0002-work.XXXXXX)
+{
+	first=$(git -C "$src" rev-parse "${merges[0]}")
+	p1=$(git -C "$src" rev-parse "$first^1")
+	p2=$(git -C "$src" rev-parse "$first^2")
+	extract "$src" "$p1" "" "$dir"
+	write_upstream_record "$dir" "$src" "" "$(git -C "$src" merge-base "$p1" "$p2")"
+	git add -A -f -- "$dir"
+	pi_commit "spike 0002: chain port for candidate $cand"
+	for k in $(seq 0 "$last"); do
+		m=$(git -C "$src" rev-parse "${merges[$k]}")
+		p1=$(git -C "$src" rev-parse "$m^1")
+		p2=$(git -C "$src" rev-parse "$m^2")
+		recorded=$(recorded_base "$dir")
+		gitbase=$(git -C "$src" merge-base "$p1" "$p2")
+		echo "===== step $((k + 1)): merge ${merges[$k]}"
+		echo "recorded-base=$recorded git-merge-base=$gitbase $([ "$recorded" = "$gitbase" ] && echo BASE-MATCH || echo BASE-DIFFERENT)"
+		rm -rf "$work/p1" && extract "$src" "$p1" "" "$work/p1" && : >"$work/none"
+		echo "pi side before sync equals the fork's first parent: $(compare_dirs "$work/p1" "$dir" "$work/none" | tr '\n' ' ')"
+		"spike/sync-$cand.sh" "$src" "" "$recorded" "$p2" "$dir" </dev/null >"$work/sync.out" 2>&1
+		echo "sync-exit=$?"
+		rm -rf "$work/auto"
+		tree=$(automatic_result "$src" "$p1" "$p2" "" "$work/auto" "$work/auto-conflicts")
+		sed -n '/^unmerged:/,/^scratch:/p' "$work/sync.out" | sed '1d;/^scratch:/d;/^$/d' | sort >"$work/cand-conflicts"
+		echo "merge-tree=$tree expected-conflicted=[$(tr '\n' ' ' <"$work/auto-conflicts")] candidate-conflicted=[$(tr '\n' ' ' <"$work/cand-conflicts")]"
+		if cmp -s "$work/auto-conflicts" "$work/cand-conflicts"; then echo "CONFLICT-SET: EQUAL"; else echo "CONFLICT-SET: DIFFERENT"; fi
+		echo "comparison: $(compare_dirs "$work/auto" "$dir" "$work/auto-conflicts" | tr '\n' ' ')"
+		# The fork's committed resolution replaces each conflicted file, as a person would.
+		while IFS= read -r f; do
+			[ -z "$f" ] && continue
+			git -C "$src" show "$m:$f" >"$dir/$f"
+			echo "resolved $f from the fork's merge commit"
+		done <"$work/auto-conflicts"
+		write_upstream_record "$dir" "$src" "" "$p2"
+		git add -A -f -- "$dir"
+		pi_commit "spike 0002: chain step $((k + 1)) for candidate $cand"
+		rm -rf "$work/m" && extract "$src" "$m" "" "$work/m"
+		echo "pi side after resolution equals the fork's merge commit: $(compare_dirs "$work/m" "$dir" "$work/none" | tr '\n' ' ')"
+		if [ "$k" -lt "$last" ]; then
+			nextp1=$(git -C "$src" rev-parse "${merges[$((k + 1))]}^1")
+			own=$(git -C "$src" rev-list --count "$m..$nextp1")
+			echo "fork commits between this merge and the next first parent: $own"
+			if [ "$own" -gt 0 ]; then
+				git -C "$src" diff --binary "$m" "$nextp1" | git apply --index --directory="$dir"
+				pi_commit "spike 0002: chain fork commits after step $((k + 1)) for candidate $cand"
+			fi
+		fi
+	done
+	echo "===== containment: status entries outside $dir"
+	outside=$(git status --porcelain | awk -v d="$dir/" '{p=substr($0,4); if (index(p,d)!=1 && index(p,"spike/")!=1) print}')
+	if [ -z "$outside" ]; then echo "(none)"; else echo "$outside"; fi
+	echo "===== cleanup"
+	git rm -r -q -f -- "$dir" >/dev/null 2>&1
+	rm -rf "$dir"
+	pi_commit "spike 0002: drop chain for candidate $cand" 2>/dev/null || true
+} >"$out" 2>&1
+rm -rf "$work"
+echo "$out"
