+#!/usr/bin/env bash
+# C2 and C3: one merge, ported from its first parent with the recorded base, synced to its
+# second parent, compared with Git's automatic result.
+# Usage: spike/single.sh <case> <repo> <subdir or ""> <merge> <recorded base> <package dir name>
+set -u
+. spike/lib.sh
+case=$1 repo=$2 sub=$3 merge=$4 recorded=$5
+dir=packages/builtins/$6
+out="spike/runs/$case.txt"
+pi=$(pi_worktree "$case") || { echo "worktree creation failed"; exit 1; }
+work=$(mktemp -d /tmp/spike-0004-work.XXXXXX)
+m=$(git -C "$repo" rev-parse "$merge")
+p1=$(git -C "$repo" rev-parse "$m^1")
+p2=$(git -C "$repo" rev-parse "$m^2")
+port "$pi" "$dir" "$repo" "$sub" "$p1" "$recorded"
+{
+	echo "case $case: merge $merge = $m, first parent $p1, second parent $p2, subdir ${sub:-<root>}"
+	echo "recorded-base=$(git -C "$repo" rev-parse "$recorded") git-merge-base=$(git -C "$repo" merge-base "$p1" "$p2")"
+	echo "===== sync"
+} >"$out"
+code=$(run_sync "$out" "$pi" "$dir" "$p2")
+{
+	echo "===== Git's automatic result"
+	echo "merge-tree: $(oracle "$repo" "$p1" "$p2" "$sub" "$work/auto" "$work/conf")"
+	candidate_conflicts "$out" >"$work/cand"
+	echo "git conflicted ($(grep -c . "$work/conf")): $(tr '\n' ' ' <"$work/conf")"
+	echo "sync conflicted ($(grep -c . "$work/cand")): $(tr '\n' ' ' <"$work/cand")"
+	cmp -s "$work/conf" "$work/cand" && echo "CONFLICT-SET: EQUAL" || echo "CONFLICT-SET: DIFFERENT"
+	echo "comparison (UPSTREAM.json excluded): $(compare "$work/auto" "$pi/$dir" "$work/conf" | tr '\n' ' ')"
+	echo "containment, status outside $dir: $(containment "$pi" "$dir" | tr '\n' ' ')"
+	echo "index, result paths missing from the index: $(index_missing "$pi" "$dir" | tr '\n' ' ')"
+	[ -e "$pi/$dir/TODO.md" ] && echo "TODO.md in the index: $(git -C "$pi" ls-files -- "$dir/TODO.md" | grep -c .)"
+} >>"$out"
+drop_pi_worktree "$pi"
+rm -rf "$work"
+echo "$case exit=$code"
