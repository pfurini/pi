+#!/usr/bin/env bash
+# Every frozen case, with the fork working trees' status recorded before and after (C9).
+set -u
+. spike/lib.sh
+{
+	echo "before: bridge [$(git -C "$BRIDGE" status --porcelain | tr '\n' ';')] rpiv [$(git -C "$RPIV" status --porcelain | tr '\n' ';')]"
+} >spike/runs/00-fork-status.txt
+spike/chain.sh
+spike/single.sh R6 "$RPIV" packages/rpiv-ask-user-question ce35c164 0fdf4f8 rpiv-ask-user-question
+spike/single.sh K1 "$BRIDGE" "" 402fa8d 4a7920a pi-claude-bridge
+spike/uptodate-u2.sh
+spike/guards.sh
+drop_pi_worktree "$(cat spike/runs/chain-worktree.txt)"
+git -C "$MAIN_REPO" worktree prune
+{
+	echo "after: bridge [$(git -C "$BRIDGE" status --porcelain | tr '\n' ';')] rpiv [$(git -C "$RPIV" status --porcelain | tr '\n' ';')]"
+	echo "remaining spike-0004-pi worktrees: $(git -C "$MAIN_REPO" worktree list | grep -c spike-0004-pi)"
+} >>spike/runs/00-fork-status.txt
+cat spike/runs/00-fork-status.txt
