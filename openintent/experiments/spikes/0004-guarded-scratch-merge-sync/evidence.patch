+#!/usr/bin/env bash
+# C4 (U1), C5 (G1, G4), C6 (G2a, G2b) and C7 (G3). Each case starts from a fresh Pi worktree
+# at the state after R5 that spike/chain.sh recorded.
+set -u
+. spike/lib.sh
+dir=packages/builtins/pi-claude-bridge
+state=$(cat spike/runs/state-after-R5.txt)
+full() { git -C "$BRIDGE" rev-parse "$1"; }
+set_base() { # <pi> <base>
+	node -e 'const fs=require("fs");const p=process.argv[1];fs.writeFileSync(p,fs.readFileSync(p,"utf8").replace(/("base":\s*")[0-9a-fA-F]*(")/,"$1"+process.argv[2]+"$2"))' "$1/$dir/UPSTREAM.json" "$2"
+}
+
+# guard_case <case> <new> <setup function name>
+guard_case() {
+	local case=$1 new=$2 setup=$3 out="spike/runs/$1.txt" pi head_before code readme_before
+	pi=$(pi_worktree "$case" "$state") || { echo "worktree creation failed"; return 1; }
+	"$setup" "$pi"
+	head_before=$(git -C "$pi" rev-parse HEAD)
+	readme_before=$(shasum -a 256 "$pi/$dir/README.md" | cut -d' ' -f1)
+	{
+		echo "case $case: from state $state, new $new"
+		echo "record before: $(tr -d '\n\t' <"$pi/$dir/UPSTREAM.json")"
+		echo "trailer before: $(git -C "$pi" log -1 --format='%(trailers:key=Upstream-Base,valueonly)' -- "$dir/UPSTREAM.json" | tr -d '\n')"
+		echo "status before: $(git -C "$pi" status --porcelain --ignored | tr '\n' ' ')"
+		echo "===== sync"
+	} >"$out"
+	code=$(run_sync "$out" "$pi" "$dir" "$new")
+	{
+		echo "===== after"
+		echo "status after (--ignored): $(git -C "$pi" status --porcelain --ignored | tr '\n' ' ')"
+		echo "HEAD unchanged: $([ "$(git -C "$pi" rev-parse HEAD)" = "$head_before" ] && echo yes || echo NO)"
+		echo "README.md unchanged: $([ "$(shasum -a 256 "$pi/$dir/README.md" | cut -d' ' -f1)" = "$readme_before" ] && echo yes || echo NO)"
+		echo "containment, status outside $dir: $(containment "$pi" "$dir" | tr '\n' ' ')"
+	} >>"$out"
+	drop_pi_worktree "$pi"
+	echo "$case exit=$code"
+}
+
+no_setup() { :; }
+g2a_setup() {
+	set_base "$1" "$(full 44fe582)"
+	git -C "$1" add -- "$dir/UPSTREAM.json"
+	pi_commit "$1" "hand edit of the base without a trailer"
+}
+g2b_setup() {
+	set_base "$1" "$(full 44fe582)"
+	git -C "$1" add -- "$dir/UPSTREAM.json"
+	pi_commit "$1" "hand edit of the base with a stale trailer" "$(full 0750748)"
+}
+g3_setup() {
+	printf '\nSPIKE-0004 uncommitted edit.\n' >>"$1/$dir/README.md"
+}
+g4_setup() {
+	set_base "$1" 1111111111111111111111111111111111111111
+	git -C "$1" add -- "$dir/UPSTREAM.json"
+	pi_commit "$1" "base absent from the clone, matching trailer" 1111111111111111111111111111111111111111
+}
+
+guard_case U1 "$(full 0750748)" no_setup
+guard_case G1 "$(full 44fe582)" no_setup
+guard_case G2a "$(full 0750748)" g2a_setup
+guard_case G2b "$(full 0750748)" g2b_setup
+guard_case G3 "$(full 227f5eb)" g3_setup
+guard_case G4 "$(full 0750748)" g4_setup
diff --git a/spike/lib.sh b/spike/lib.sh
new file mode 100755
index 000000000..4b1c87b80
--- /dev/null
+++ b/spike/lib.sh
@@ -0,0 +1,138 @@
+#!/usr/bin/env bash
+# SPIKE-0004 harness helpers. Source from the worktree root.
+MAIN_REPO=/Users/paolof/Developer/ai/pi
+FROZEN_AT=de669e504d0cf32a40f6941d95c7742fcb073057
+BRIDGE=/Users/paolof/Developer/ai/pi-claude-bridge
+RPIV=/Users/paolof/Developer/ai/rpiv-mono
+SPIKE_ROOT=$(pwd)
+SYNC="$SPIKE_ROOT/spike/sync-upstream.sh"
+
+# pi_worktree <name> [commit] -> prints the path of a disposable Pi worktree under test.
+pi_worktree() {
+	local path
+	path=$(mktemp -d "/tmp/spike-0004-pi-$1.XXXXXX")
+	rmdir "$path"
+	git -C "$MAIN_REPO" worktree add -q --detach "$path" "${2:-$FROZEN_AT}" >/dev/null 2>&1 || return 1
+	echo "$path"
+}
+
+drop_pi_worktree() {
+	git -C "$MAIN_REPO" worktree remove --force "$1" >/dev/null 2>&1
+}
+
+# extract <repo> <tree-ish> <outdir>: files of a tree through a private index.
+extract() {
+	local idx out=$3
+	case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
+	idx=$(mktemp /tmp/spike-0004-idx.XXXXXX)
+	rm -f "$idx"
+	mkdir -p "$out"
+	GIT_INDEX_FILE="$idx" git -C "$1" read-tree "$2"
+	GIT_INDEX_FILE="$idx" git -C "$1" checkout-index -a -f --prefix="$out/"
+	rm -f "$idx"
+}
+
+treeish() { # <commit> <subdir or "">
+	if [ -n "$2" ]; then echo "$1:$2"; else echo "$1^{tree}"; fi
+}
+
+pi_commit() { # <pi> <subject> [trailer base]
+	local msg=$2
+	[ -n "${3:-}" ] && msg="$msg
+
+Upstream-Base: $3"
+	git -C "$1" -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -q --no-verify -m "$msg"
+}
+
+write_record() { # <pi> <dir> <repo> <subdir> <base>
+	printf '{\n\t"upstream": {\n\t\t"repository": "%s",\n\t\t"path": "%s",\n\t\t"base": "%s"\n\t}\n}\n' "$3" "$4" "$5" >"$1/$2/UPSTREAM.json"
+}
+
+# port <pi> <dir> <repo> <subdir> <fork state> <base>: the frozen port step.
+port() {
+	local pi=$1 dir=$2 repo=$3 sub=$4 state=$5 base
+	base=$(git -C "$repo" rev-parse "$6")
+	extract "$repo" "$(treeish "$state" "$sub")" "$pi/$dir"
+	write_record "$pi" "$dir" "$repo" "$sub" "$base"
+	git -C "$pi" add -A -f -- "$dir"
+	pi_commit "$pi" "port $dir from $(git -C "$repo" rev-parse --short "$state")" "$base"
+}
+
+# replace_dir <pi> <dir> <repo> <subdir> <commit>: new tree, UPSTREAM.json kept.
+replace_dir() {
+	local keep
+	keep=$(mktemp /tmp/spike-0004-record.XXXXXX)
+	cp "$1/$2/UPSTREAM.json" "$keep"
+	find "$1/$2" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
+	extract "$3" "$(treeish "$5" "$4")" "$1/$2"
+	cp "$keep" "$1/$2/UPSTREAM.json"
+	rm -f "$keep"
+}
+
+# run_sync <outfile> <pi> <dir> <new>: own process group, stdin closed, 60-second alarm.
+# Prints the exit code; appends the sync's output and the process facts to <outfile>.
+run_sync() {
+	local out=$1 start end code pgid survivors
+	start=$(perl -MTime::HiRes=time -e 'printf "%.2f", time')
+	perl -e 'setpgrp(0,0); alarm 60; exec @ARGV' -- "$SYNC" "$2" "$3" "$4" </dev/null >"$out.sync" 2>&1 &
+	pgid=$!
+	wait "$pgid"
+	code=$?
+	end=$(perl -MTime::HiRes=time -e 'printf "%.2f", time')
+	survivors=$(ps -o pid=,command= -g "$pgid" 2>/dev/null | grep -v '^ *$' || true)
+	{
+		cat "$out.sync"
+		echo "sync-exit=$code seconds=$(perl -e "printf '%.2f', $end - $start") stdin=/dev/null tty=$([ -t 1 ] && echo yes || echo no)"
+		echo "survivors-in-process-group: ${survivors:-none}"
+	} >>"$out"
+	rm -f "$out.sync"
+	echo "$code"
+}
+
+# oracle <repo> <p1> <p2> <subdir> <outdir> <conflicts-file>: Git's automatic result.
+oracle() {
+	local raw tree
+	raw=$(git -C "$1" merge-tree --write-tree --name-only "$2" "$3")
+	tree=$(printf '%s\n' "$raw" | head -1)
+	printf '%s\n' "$raw" | sed -n '2,/^$/p' | sed '/^$/d' >"$6.all"
+	if [ -n "$4" ]; then
+		{ grep "^$4/" "$6.all" || true; } | sed "s|^$4/||" | sort >"$6"
+	else
+		sort "$6.all" >"$6"
+	fi
+	rm -f "$6.all"
+	extract "$1" "$(treeish "$tree" "$4")" "$5"
+	echo "$tree"
+}
+
+# compare <expected dir> <actual dir> <conflicted list>: excludes UPSTREAM.json.
+compare() {
+	local diffs=0 f list
+	list=$( { (cd "$1" && find . -type f -o -type l); (cd "$2" && find . -type f -o -type l); } | sed 's|^\./||' | grep -v '^UPSTREAM.json$' | sort -u)
+	while IFS= read -r f; do
+		[ -z "$f" ] && continue
+		if [ ! -e "$1/$f" ] && [ ! -L "$1/$f" ]; then echo "ONLY-IN-RESULT $f"; diffs=$((diffs + 1)); continue; fi
+		if [ ! -e "$2/$f" ] && [ ! -L "$2/$f" ]; then echo "ONLY-IN-GIT $f"; diffs=$((diffs + 1)); continue; fi
+		if [ "$(stat -f '%Lp' "$1/$f")" != "$(stat -f '%Lp' "$2/$f")" ]; then echo "MODE $f"; diffs=$((diffs + 1)); fi
+		grep -qxF "$f" "$3" && continue
+		cmp -s "$1/$f" "$2/$f" || { echo "CONTENT $f"; diffs=$((diffs + 1)); }
+	done <<<"$list"
+	[ "$diffs" -eq 0 ] && echo "IDENTICAL"
+	return 0
+}
+
+candidate_conflicts() { # <run file> -> sorted conflicted list from the sync's output
+	sed -n '/^conflicted:$/,/^SYNC OUTCOME/p' "$1" | sed '1d;$d' | sed '/^$/d' | sort
+}
+
+containment() { # <pi> <dir>: status entries outside the package directory, or (none)
+	local outside
+	outside=$(git -C "$1" status --porcelain --ignored --untracked-files=all | awk -v d="$2/" '{p=substr($0,4); if (index(p,d)!=1) print}')
+	if [ -z "$outside" ]; then echo "(none)"; else echo "$outside"; fi
+}
+
+index_missing() { # <pi> <dir>: result paths absent from the index, or (none)
+	local missing
+	missing=$(comm -23 <(cd "$1/$2" && find . -type f -o -type l | sed 's|^\./||' | sort) <(git -C "$1" ls-files -- "$2" | sed "s|^$2/||" | sort))
+	if [ -z "$missing" ]; then echo "(none)"; else echo "$missing"; fi
+}
