@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# C1 (with C8, C9 and C10 facets): the five pi-claude-bridge sync merges R1 to R5 in order.
+# Writes spike/runs/R1.txt ... R5.txt and spike/runs/state-after-R5.txt.
+set -u
+. spike/lib.sh
+merges=(c4b759f 60efeb9 6feed8f 64e3c25 d233e0a)
+dir=packages/builtins/pi-claude-bridge
+pi=$(pi_worktree chain) || { echo "worktree creation failed"; exit 1; }
+echo "$pi" >spike/runs/chain-worktree.txt
+first=$(git -C "$BRIDGE" rev-parse "${merges[0]}")
+port "$pi" "$dir" "$BRIDGE" "" "$first^1" 7e41218
+work=$(mktemp -d /tmp/spike-0004-work.XXXXXX)
+: >"$work/none"
+for k in 0 1 2 3 4; do
+	m=$(git -C "$BRIDGE" rev-parse "${merges[$k]}")
+	p1=$(git -C "$BRIDGE" rev-parse "$m^1")
+	p2=$(git -C "$BRIDGE" rev-parse "$m^2")
+	out="spike/runs/R$((k + 1)).txt"
+	{
+		echo "case R$((k + 1)): sync merge ${merges[$k]} = $m, first parent $p1, second parent $p2"
+		recorded=$(node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).upstream.base)' "$pi/$dir/UPSTREAM.json")
+		gitbase=$(git -C "$BRIDGE" merge-base "$p1" "$p2")
+		echo "recorded-base=$recorded git-merge-base=$gitbase $([ "$recorded" = "$gitbase" ] && echo BASE-MATCH || echo BASE-DIFFERENT)"
+		rm -rf "$work/p1" && extract "$BRIDGE" "$p1^{tree}" "$work/p1"
+		echo "pi side before sync equals the fork state: $(compare "$work/p1" "$pi/$dir" "$work/none" | tr '\n' ' ')"
+		echo "===== sync"
+	} >"$out"
+	code=$(run_sync "$out" "$pi" "$dir" "$p2")
+	{
+		echo "===== Git's automatic result"
+		rm -rf "$work/auto"
+		echo "merge-tree: $(oracle "$BRIDGE" "$p1" "$p2" "" "$work/auto" "$work/conf")"
+		candidate_conflicts "$out" >"$work/cand"
+		echo "git conflicted ($(grep -c . "$work/conf")): $(tr '\n' ' ' <"$work/conf")"
+		echo "sync conflicted ($(grep -c . "$work/cand")): $(tr '\n' ' ' <"$work/cand")"
+		cmp -s "$work/conf" "$work/cand" && echo "CONFLICT-SET: EQUAL" || echo "CONFLICT-SET: DIFFERENT"
+		echo "comparison (UPSTREAM.json excluded): $(compare "$work/auto" "$pi/$dir" "$work/conf" | tr '\n' ' ')"
+		echo "containment, status outside $dir: $(containment "$pi" "$dir" | tr '\n' ' ')"
+		echo "index, result paths missing from the index: $(index_missing "$pi" "$dir" | tr '\n' ' ')"
+		echo "TODO.md in the index: $(git -C "$pi" ls-files -- "$dir/TODO.md" | grep -c .)"
+	} >>"$out"
+	if [ "$k" -lt 4 ]; then next="${merges[$((k + 1))]}^1"; else next=$m; fi
+	replace_dir "$pi" "$dir" "$BRIDGE" "" "$next"
+	git -C "$pi" add -A -f -- "$dir"
+	pi_commit "$pi" "fork state $(git -C "$BRIDGE" rev-parse --short "$next") after R$((k + 1))" "$p2"
+	echo "between steps: directory replaced with $(git -C "$BRIDGE" rev-parse --short "$next"), committed with Upstream-Base $p2" >>"$out"
+	echo "R$((k + 1)) exit=$code"
+done
+git -C "$pi" rev-parse HEAD >spike/runs/state-after-R5.txt
+echo "state after R5: $(cat spike/runs/state-after-R5.txt)"
+rm -rf "$work"
