+#!/usr/bin/env bash
+# C4, case U2: rpiv-mono's package directory ported at cb1ee6e, synced to 7392135, whose
+# subtree is unchanged. Expect exit 3 and a directory that differs only in the base value.
+set -u
+. spike/lib.sh
+dir=packages/builtins/rpiv-ask-user-question
+sub=packages/rpiv-ask-user-question
+out=spike/runs/U2.txt
+pi=$(pi_worktree U2) || { echo "worktree creation failed"; exit 1; }
+port "$pi" "$dir" "$RPIV" "$sub" cb1ee6e cb1ee6e
+snap=$(mktemp -d /tmp/spike-0004-snap.XXXXXX)
+cp -Rp "$pi/$dir/." "$snap/"
+head_before=$(git -C "$pi" rev-parse HEAD)
+{
+	echo "case U2: subtree at cb1ee6e $(git -C "$RPIV" rev-parse "cb1ee6e:$sub") and at 7392135 $(git -C "$RPIV" rev-parse "7392135:$sub")"
+	echo "===== sync"
+} >"$out"
+code=$(run_sync "$out" "$pi" "$dir" 7392135)
+{
+	echo "===== after"
+	echo "paths that differ from before:"
+	diff -rq "$snap" "$pi/$dir" || true
+	echo "UPSTREAM.json diff:"
+	diff "$snap/UPSTREAM.json" "$pi/$dir/UPSTREAM.json" || true
+	echo "HEAD unchanged: $([ "$(git -C "$pi" rev-parse HEAD)" = "$head_before" ] && echo yes || echo NO)"
+	echo "containment, status outside $dir: $(containment "$pi" "$dir" | tr '\n' ' ')"
+} >>"$out"
+drop_pi_worktree "$pi"
+rm -rf "$snap"
+echo "U2 exit=$code"
